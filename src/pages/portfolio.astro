---
import CtaBand from '../components/CtaBand.astro';
import GalleryItem from '../components/GalleryItem.astro';
import Lightbox from '../components/Lightbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildRows, sizesFor } from '../lib/layout';
import { getChapters, getPhoto, unusedPhotoFiles } from '../lib/photos';

const chapters = getChapters().map((chapter) => {
  const [first, ...rest] = chapter.title.split(' ');
  return { ...chapter, lead: first, accent: rest.join(' '), rows: buildRows(chapter.photos) };
});
const total = chapters.reduce((sum, c) => sum + c.photos.length, 0);

// Rappel au build : photos déposées dans /assets/photos mais pas encore rangées.
const unused = unusedPhotoFiles();
if (unused.length) {
  console.warn(
    `[photos] Présentes dans /assets/photos mais absentes de src/data/photos.ts (non affichées) : ${unused.join(', ')}`,
  );
}

const ctaPhoto = getPhoto('image00062.jpeg');
---

<BaseLayout
  title="Portfolio mariage, Toulouse & Sud-Ouest | Niveal Studio"
  description="Mariages photographiés dans le Sud-Ouest et ailleurs par Anna Aguerre : préparatifs, cérémonie, couple et réception, en couleur et en noir et blanc."
>
  <section class="pf-intro container" aria-labelledby="pf-title">
    <h1 id="pf-title" class="pf-intro__title">
      <span class="eyebrow">Portfolio · <span class="nowrap">Sud-Ouest</span> &amp; <span lang="en">Worldwide</span></span>
      <span class="caps pf-intro__heading">Mariages</span>
    </h1>
    <p class="lead pf-intro__lead">
      Une journée telle qu’elle se vit, <em>avec l’exigence d’une image composée.</em>
    </p>

    <nav class="pf-toc" aria-label="Chapitres du portfolio">
      <ol>
        {
          chapters.map((c) => (
            <li>
              <a class="pf-toc__link" href={`#${c.id}`}>
                <span class="pf-toc__num">{c.number}</span>
                <span class="pf-toc__label">{c.label}</span>
                <span class="pf-toc__count">{c.photos.length}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="pf-toc__total eyebrow">{total} photos, à ouvrir en grand</p>
    </nav>
  </section>

  {
    chapters.map((c, ci) => (
      <>
        <section class="pf-chapter" id={c.id} aria-labelledby={`${c.id}-title`}>
          <header class="pf-chapter__head container">
            <p class="pf-chapter__num" aria-hidden="true">
              {c.number}
            </p>
            <h2 id={`${c.id}-title`} class="display pf-chapter__title">
              {c.lead} <em>{c.accent}</em>
            </h2>
            <p class="eyebrow pf-chapter__count">{c.photos.length} photos</p>
          </header>

          <div class="container pf-rows">
            {c.rows.map((row) => (
              <div class="pf-row" style={`--sum: ${row.sum.toFixed(4)}`}>
                {row.lines.map((line) => (
                  <div class="pf-line">
                    {line.map((photo) => (
                      <GalleryItem photo={photo} sizes={sizesFor(photo, row)} chapter={c.label} />
                    ))}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </section>

        {ci === 1 && (
          <aside class="pf-interlude container" aria-label="Citation">
            <p class="display pf-interlude__text" data-reveal>
              «&nbsp;L’émotion prise sur le vif, et <em>l’exigence d’une image composée.</em>&nbsp;»
            </p>
            <p class="eyebrow pf-interlude__author" data-reveal>Anna Aguerre</p>
          </aside>
        )}
      </>
    ))
  }

  <CtaBand
    photo={ctaPhoto}
    position="50% 62%"
    links={[
      { href: '/contact/', label: 'Me contacter' },
      { href: '/a-propos/', label: 'Qui je suis' },
    ]}
  />

  <Lightbox />
</BaseLayout>

<style>
  /* ============================================================ INTRO */

  .pf-intro {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-m);
  }

  .pf-intro__title {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .pf-intro__heading {
    font-size: clamp(3rem, 0.8rem + 10vw, 12.5rem);
    letter-spacing: 0.1em;
    line-height: 0.92;
  }

  .pf-intro__lead {
    max-width: 34rem;
    margin-top: var(--space-l);
  }

  .pf-toc {
    margin-top: var(--space-l);
  }

  .pf-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    border-top: 1px solid var(--line-strong);
  }

  .pf-toc__link {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 1.1rem 0.25rem 1.1rem 0;
    border-bottom: 1px solid var(--line);
    transition: opacity 0.3s;
  }

  .pf-toc__link:hover {
    opacity: 0.55;
  }

  .pf-toc__num {
    font-family: var(--serif);
    font-style: italic;
    color: var(--muted);
  }

  .pf-toc__label {
    flex: 1;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    line-height: 1.1;
  }

  .pf-toc__count {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .pf-toc__total {
    margin-top: 1.25rem;
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .pf-toc ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ========================================================= CHAPITRES */

  .pf-chapter {
    padding-top: var(--space-xl);
  }

  .pf-chapter__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: clamp(1rem, 3vw, 3rem);
    margin-bottom: var(--space-m);
  }

  .pf-chapter__head::after {
    content: '';
    grid-column: 1 / -1;
    height: 1px;
    margin-top: var(--space-s);
    background: var(--line-strong);
  }

  .pf-chapter__num {
    font-family: var(--serif);
    font-weight: 430;
    font-variation-settings: 'opsz' 56;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 7rem);
    font-style: italic;
    line-height: 0.9;
  }

  .pf-chapter__title {
    font-size: clamp(2rem, 1.2rem + 3.4vw, 5rem);
  }

  .pf-chapter__count {
    color: var(--muted);
  }

  @media (max-width: 39.99em) {
    .pf-chapter__count {
      display: none;
    }
  }

  /* ============================================ LIGNES DE PHOTOS */

  .pf-rows {
    --pf-gap: clamp(0.4rem, 0.9vw, 0.9rem);
    display: flex;
    flex-direction: column;
    gap: var(--pf-gap);
  }

  /* Mobile : chaque ligne est redécoupée en petites lignes (2 portraits, ou 1 paysage). */
  .pf-row {
    display: flex;
    flex-direction: column;
    gap: var(--pf-gap);
  }

  .pf-line {
    display: flex;
    gap: var(--pf-gap);
  }

  /* Une photo seule sur sa petite ligne mobile prend toute la largeur. */
  @media (max-width: 39.99em) {
    .pf-line > :global(.pf-item:only-child) {
      flex: 1 1 100%;
    }
  }

  /* Tablette et ordinateur : toute la ligne sur une seule rangée, pleine largeur. */
  @media (min-width: 40em) {
    .pf-row {
      flex-direction: row;
      /* une ligne très haute (peu de photos) ne dépasse pas la hauteur de l'écran */
      width: min(100%, calc(var(--sum) * 80svh));
      margin-inline: auto;
    }

    .pf-line {
      display: contents;
    }
  }

  /* ========================================================= INTERLUDE */

  .pf-interlude {
    padding-block: var(--space-xl) var(--space-s);
    text-align: center;
  }

  .pf-interlude__text {
    max-width: 22ch;
    margin-inline: auto;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 4.75rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pf-interlude__author {
    margin-top: var(--space-m);
    color: var(--muted);
  }
</style>
