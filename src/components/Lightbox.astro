---
/**
 * Visionneuse plein écran du portfolio.
 * S'ouvre au clic sur tout lien [data-lightbox] de la page ; navigation au
 * clavier (← →, Échap), au balayage sur mobile et avec les flèches.
 */
---

<dialog class="lightbox" aria-label="Visionneuse de photos" data-lightbox-dialog>
  <div class="lightbox__bar">
    <p class="lightbox__meta">
      <span class="lightbox__count">
        <span data-lb-current>1</span><span class="lightbox__sep" aria-hidden="true">/</span><span data-lb-total></span>
      </span>
      <span class="lightbox__chapter" data-lb-chapter></span>
    </p>
    <button class="lightbox__close" type="button" data-lb-close>Fermer</button>
  </div>

  <div class="lightbox__stage" data-lb-stage>
    <img class="lightbox__img" alt="" decoding="async" data-lb-img />
  </div>

  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Photo précédente" data-lb-prev>
    <svg viewBox="0 0 48 16" aria-hidden="true"><path d="M47 8H1M8 1L1 8l7 7"></path></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Photo suivante" data-lb-next>
    <svg viewBox="0 0 48 16" aria-hidden="true"><path d="M1 8h46M40 1l7 7-7 7"></path></svg>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')];

  if (dialog && links.length) {
    const root = document.documentElement;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const current = dialog.querySelector<HTMLElement>('[data-lb-current]')!;
    const chapter = dialog.querySelector<HTMLElement>('[data-lb-chapter]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    dialog.querySelector<HTMLElement>('[data-lb-total]')!.textContent = String(links.length);

    let index = 0;

    /** Largeur réellement affichée : l'image tient dans l'écran sans être rognée. */
    const sizesFor = (link: HTMLAnchorElement) => {
      const ratio = Number(link.dataset.width) / Number(link.dataset.height);
      const box = stage.getBoundingClientRect();
      const width = Math.min(box.width || window.innerWidth, (box.height || window.innerHeight) * ratio);
      return `${Math.ceil(width)}px`;
    };

    const wrap = (i: number) => (i + links.length) % links.length;

    const preload = (i: number) => {
      const link = links[wrap(i)];
      const image = new Image();
      image.sizes = sizesFor(link);
      image.srcset = link.dataset.srcset ?? '';
      image.src = link.href;
    };

    const show = (i: number) => {
      index = wrap(i);
      const link = links[index];
      img.classList.remove('is-loaded');
      img.width = Number(link.dataset.width);
      img.height = Number(link.dataset.height);
      img.sizes = sizesFor(link);
      img.srcset = link.dataset.srcset ?? '';
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      current.textContent = String(index + 1);
      chapter.textContent = link.dataset.chapter ?? '';
      if (img.complete) img.classList.add('is-loaded');
      preload(index + 1);
      preload(index - 1);
    };

    img.addEventListener('load', () => img.classList.add('is-loaded'));

    const open = (i: number) => {
      dialog.showModal();
      root.classList.add('is-locked');
      show(i);
      requestAnimationFrame(() => dialog.classList.add('is-open'));
    };

    const close = () => {
      if (!dialog.open) return;
      dialog.classList.remove('is-open');
      root.classList.remove('is-locked');
      window.setTimeout(
        () => {
          dialog.close();
          // Retour sur la dernière photo regardée.
          links[index].focus();
        },
        reduced.matches ? 0 : 320,
      );
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        open(i);
      }),
    );

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(index + 1);
      else if (event.key === 'ArrowLeft') show(index - 1);
      else if (event.key === 'Home') show(0);
      else if (event.key === 'End') show(links.length - 1);
      else return;
      event.preventDefault();
    });

    // Balayage horizontal (mobile) ; un clic hors de la photo ferme la visionneuse.
    let startX = 0;
    let startY = 0;
    let swiped = false;
    stage.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
      startY = event.clientY;
      swiped = false;
    });
    stage.addEventListener('pointerup', (event) => {
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        swiped = true;
        show(dx < 0 ? index + 1 : index - 1);
      }
    });
    stage.addEventListener('click', (event) => {
      if (!swiped && event.target === stage) close();
    });

    window.addEventListener('resize', () => {
      if (dialog.open) img.sizes = sizesFor(links[index]);
    });
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0c0b0a;
    color: var(--paper);
    display: none;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    overscroll-behavior: contain;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: var(--header-h) minmax(0, 1fr) var(--header-h);
  }

  .lightbox.is-open {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-inline: var(--gutter);
  }

  .lightbox__meta {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .lightbox__count {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-style: italic;
    font-variant-numeric: lining-nums;
  }

  .lightbox__sep {
    margin-inline: 0.4em;
    font-style: normal;
    color: var(--on-dark-muted);
  }

  .lightbox__chapter,
  .lightbox__close {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .lightbox__chapter {
    color: var(--on-dark-muted);
  }

  .lightbox__close {
    padding: 0.75rem 0;
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    padding-inline: var(--gutter);
    touch-action: pan-y pinch-zoom;
  }

  .lightbox__img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(100svh - 2 * var(--header-h));
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox__img.is-loaded {
    opacity: 1;
  }

  .lightbox__nav {
    position: absolute;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 5rem;
    height: var(--header-h);
    transition: opacity 0.3s;
  }

  .lightbox__nav:hover {
    opacity: 0.6;
  }

  .lightbox__nav svg {
    width: 2.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
  }

  .lightbox__nav--prev {
    left: calc(var(--gutter) - 1rem);
  }

  .lightbox__nav--next {
    right: calc(var(--gutter) - 1rem);
  }

  @media (min-width: 64em) {
    .lightbox__stage {
      padding-inline: 7rem;
    }

    .lightbox__nav {
      top: 50%;
      bottom: auto;
      height: 5rem;
      translate: 0 -50%;
    }

    .lightbox__nav--prev {
      left: 1rem;
    }

    .lightbox__nav--next {
      right: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox__img {
      transition: none;
    }
  }
</style>
