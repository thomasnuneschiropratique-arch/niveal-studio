---
import { SITE } from '../config';
import { logoSize } from '../lib/brand';
import { isCurrent, link } from '../lib/url';
import InstagramIcon from './InstagramIcon.astro';

interface Props {
  /** En-tête transparent, texte blanc, posé sur une photo (page d'accueil). */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const { pathname } = Astro.url;
const logo = await logoSize();

const left = [
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/a-propos/', label: 'À propos' },
];
const menu = [
  { href: '/', label: 'Accueil' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/contact/', label: 'Contact' },
];
const current = (href: string) => (isCurrent(href, pathname) ? 'page' : undefined);
---

<header class="site-header" data-variant={overlay ? 'overlay' : 'solid'} data-site-header>
  <div class="site-header__inner">
    <nav class="site-header__nav site-header__nav--left" aria-label="Navigation principale">
      <ul>
        {
          left.map((item) => (
            <li>
              <a class="underline" href={link(item.href)} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="site-header__instagram site-header__instagram--mobile"
      href={SITE.instagram.url}
      target="_blank"
      rel="noopener"
      aria-label={`Instagram ${SITE.instagram.handle} (nouvel onglet)`}
    >
      <InstagramIcon />
    </a>

    <a class="site-header__logo" href={link('/')} aria-label={`${SITE.name}, accueil`}>
      <img
        class="site-header__logo-img site-header__logo-img--black"
        src={link('/brand/logo-black.png')}
        width={logo.width}
        height={logo.height}
        alt=""
      />
      <img
        class="site-header__logo-img site-header__logo-img--white"
        src={link('/brand/logo-white.png')}
        width={logo.width}
        height={logo.height}
        alt=""
      />
    </a>

    <div class="site-header__nav site-header__nav--right">
      <ul>
        <li>
          <a class="underline" href={link('/contact/')} aria-current={current('/contact/')}>Contact</a>
        </li>
        <li>
          <a
            class="site-header__instagram"
            href={SITE.instagram.url}
            target="_blank"
            rel="noopener"
            aria-label={`Instagram ${SITE.instagram.handle} (nouvel onglet)`}
          >
            <InstagramIcon />
          </a>
        </li>
      </ul>
    </div>

    <button
      class="site-header__toggle"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-open
    >
      Menu
    </button>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Menu" data-menu>
  <div class="menu__top">
    <img
      class="menu__logo"
      src={link('/brand/logo-white.png')}
      width={logo.width}
      height={logo.height}
      alt={SITE.name}
    />
    <button class="menu__close" type="button" data-menu-close>Fermer</button>
  </div>
  <nav class="menu__nav" aria-label="Menu principal">
    <ol>
      {
        menu.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a href={link(item.href)} aria-current={current(item.href)}>
              <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__bottom">
    <a class="menu__instagram" href={SITE.instagram.url} target="_blank" rel="noopener">
      <InstagramIcon size={16} />
      <span>{SITE.instagram.handle}</span>
    </a>
    <p class="menu__tagline" lang="en">{SITE.tagline}</p>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    color: var(--ink);
    transition:
      transform 0.6s var(--ease),
      background-color 0.5s var(--ease),
      color 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .site-header[data-variant='solid'],
  .site-header.is-scrolled {
    background: rgb(247 245 240 / 0.94);
    box-shadow: 0 1px 0 var(--line);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header[data-variant='solid'],
    .site-header.is-scrolled {
      background: rgb(247 245 240 / 0.82);
      backdrop-filter: blur(14px) saturate(1.2);
      -webkit-backdrop-filter: blur(14px) saturate(1.2);
    }
  }

  .site-header[data-variant='overlay']:not(.is-scrolled) {
    color: var(--white);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  .site-header__nav a {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .site-header__nav--left {
    grid-column: 1;
    justify-self: start;
  }

  .site-header__nav--right {
    grid-column: 3;
    justify-self: end;
  }

  .site-header__logo {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: block;
    width: clamp(6.75rem, 5.5rem + 3.2vw, 8.75rem);
  }

  .site-header__logo-img {
    width: 100%;
    height: auto;
    transition: opacity 0.5s var(--ease);
  }

  .site-header__logo-img--white {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .site-header[data-variant='overlay']:not(.is-scrolled) .site-header__logo-img--white {
    opacity: 1;
  }

  .site-header[data-variant='overlay']:not(.is-scrolled) .site-header__logo-img--black {
    opacity: 0;
  }

  .site-header__instagram {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: -0.5rem;
    transition: opacity 0.3s;
  }

  .site-header__instagram:hover {
    opacity: 0.6;
  }

  .site-header__toggle {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    padding: 0.75rem 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .site-header__instagram--mobile {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  @media (max-width: 63.99em) {
    .site-header__nav {
      display: none;
    }
  }

  @media (min-width: 64em) {
    .site-header__toggle,
    .site-header__instagram--mobile {
      display: none;
    }
  }

  /* ---------------------------------------------------------------- Menu */

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) var(--space-l);
    border: 0;
    background: var(--ink);
    color: var(--paper);
    display: none;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }

  .menu[open] {
    display: flex;
  }

  .menu.is-open {
    opacity: 1;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .menu__logo {
    width: 6.75rem;
    height: auto;
  }

  .menu__close {
    padding: 0.75rem 0;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .menu__nav ol {
    width: 100%;
  }

  .menu__nav li {
    border-top: 1px solid var(--on-dark-line);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: calc(0.08s + var(--i) * 0.06s);
  }

  .menu__nav li:last-child {
    border-bottom: 1px solid var(--on-dark-line);
  }

  .menu.is-open .menu__nav li {
    opacity: 1;
    transform: none;
  }

  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: clamp(0.9rem, 2.4vh, 1.4rem);
  }

  .menu__num {
    font-family: var(--serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--on-dark-muted);
    min-width: 1.6rem;
  }

  .menu__label {
    font-family: var(--serif);
    font-weight: 430;
    font-variation-settings: 'opsz' 56;
    font-size: clamp(2.3rem, 10vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .menu__nav a[aria-current='page'] .menu__label {
    font-style: italic;
  }

  .menu__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--space-m);
  }

  .menu__instagram {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .menu__tagline {
    font-family: var(--serif);
    font-style: italic;
    color: var(--on-dark-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__nav li {
      transition: none;
    }
  }
</style>
