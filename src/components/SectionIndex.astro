---
/** Numéro de section façon magazine : « 01 ── L'approche ». */
interface Props {
  num: string;
  label: string;
  as?: 'p' | 'h2' | 'span';
  class?: string;
}
const { num, label, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['index', className]}>
  <span class="index__num">{num}</span>
  <span class="index__rule" aria-hidden="true"></span>
  <span class="index__label">{label}</span>
</Tag>
